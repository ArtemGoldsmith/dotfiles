#!/usr/bin/env bash
# Scan staged content for credentials. Exits 1 if anything is found.
#
# Standalone so both the repo-local hook and the global dispatcher can call it.
#
# Scans the full staged content of every added/modified file, not just the
# added lines: a secret that merely moves between lines must still be caught.
#
# Escape hatches, in order of preference:
#   1. Move the value to an untracked file (~/.zshrc.local) and read it there.
#   2. Append "allowlist secret" in a comment on the offending line.
#   3. git commit --no-verify   (last resort; leaves no trace in review)
#
# This directory is excluded from scanning because the rules below embed the
# very literals they match, which would otherwise flag this file.

set -uo pipefail

hooks_dir="$(git config --get core.hooksPath || echo '.git/hooks')"
findings=0

# rule|regex — one per line. Anchored to token shapes, so no entropy heuristics
# are needed and false positives stay rare.
read -r -d '' RULES <<'RULES_EOF'
Linear API key|lin_api_[A-Za-z0-9]{32,}
GitHub token|gh[pousr]_[A-Za-z0-9]{36,}
GitHub fine-grained PAT|github_pat_[A-Za-z0-9_]{60,}
GitLab PAT|glpat-[A-Za-z0-9_-]{20,}
Anthropic API key|sk-ant-[A-Za-z0-9_-]{24,}
OpenAI API key|sk-(proj-)?[A-Za-z0-9_-]{32,}
AWS access key id|AKIA[0-9A-Z]{16}
Slack token|xox[baprs]-[A-Za-z0-9-]{12,}
Google API key|AIza[0-9A-Za-z_-]{35}
Stripe live key|[sr]k_live_[A-Za-z0-9]{20,}
npm token|npm_[A-Za-z0-9]{36}
HuggingFace token|hf_[A-Za-z0-9]{34,}
DigitalOcean token|dop_v1_[a-f0-9]{64}
SendGrid key|SG\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}
Private key block|-----BEGIN [A-Z ]*PRIVATE KEY-----
Generic assignment|(api[_-]?key|secret|token|password|passwd|access[_-]?key)["']?[[:space:]]*[:=][[:space:]]*["'][A-Za-z0-9_./+-]{20,}["']
RULES_EOF

# Values that are obviously not real credentials.
PLACEHOLDER='(MASKED|REDACTED|CHANGEME|PLACEHOLDER|EXAMPLE|YOUR[_-]|DUMMY|FAKE|SAMPLE|xxxxx|\$\{|\$\(|<[a-z])'

report() {
  local rule="$1" file="$2" line="$3" text="$4" regex="$5"
  # Never echo the credential itself: a blocked commit must not leak it into
  # scrollback, CI logs, or a screen share. Show only enough of the matched
  # token to locate it on the line.
  local token hint
  token="$(printf '%s' "$text" | grep -oE -e "$regex" | head -1)"
  if [ -n "$token" ]; then
    hint="$(printf '%s…  (%d chars)' "$(printf '%s' "$token" | cut -c1-6)" "${#token}")"
  else
    hint='(match not isolated)'
  fi
  printf '  %s:%s\n    %s  →  %s\n' "$file" "$line" "$rule" "$hint"
}

while IFS= read -r -d '' file; do
  case "$file" in
    "$hooks_dir"/*|githooks/*) continue ;;
  esac

  # Skip binaries; grep on them is noise at best. NUL cannot survive a shell
  # argument, so the probe counts NUL bytes instead of matching on one.
  nul_count="$(git show ":$file" 2>/dev/null | head -c 8000 | LC_ALL=C tr -dc '\000' | wc -c | tr -d '[:space:]')"
  if [ "${nul_count:-0}" -gt 0 ]; then
    continue
  fi

  content="$(git show ":$file" 2>/dev/null)" || continue

  while IFS='|' read -r rule regex; do
    [ -n "$rule" ] || continue
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      lineno="${hit%%:*}"
      text="${hit#*:}"
      # Respect an explicit allowlist marker on the line.
      case "$text" in *"allowlist secret"*) continue ;; esac
      if printf '%s' "$text" | grep -qiE "$PLACEHOLDER"; then continue; fi
      if [ "$findings" -eq 0 ]; then
        printf '\n\033[31m✖ pre-commit: possible credentials in staged content\033[0m\n\n'
      fi
      findings=$((findings + 1))
      report "$rule" "$file" "$lineno" "$text" "$regex"
    done < <(printf '%s\n' "$content" | grep -nE -e "$regex" || true)
  done <<< "$RULES"
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "$findings" -gt 0 ]; then
  cat <<'MSG'

Commit blocked. Preferred fix: move the value into an untracked file
(e.g. ~/.zshrc.local) and reference it from there.

If this is a false positive, append "allowlist secret" in a comment on
that line, or bypass the check entirely with:

    git commit --no-verify

MSG
  exit 1
fi

exit 0
